{%- comment -%}
  Colvy — Back in stock. A "Notify me" form for sold-out sizes/variants.
  Shoppers leave a mobile number (or email); Colvy texts them once when it's
  back and their reply lands in the Colvy inbox. Sign-ups go through Shopify's
  app proxy (/apps/colvy/waitlist), which Shopify signs, so no key is exposed.
  The form follows the variant picker and only shows for options that can't
  be bought. In the theme editor it always shows, so it can be styled.
{%- endcomment -%}
{%- liquid
  assign p = product
  if p == blank
    assign p = block.settings.product
  endif
  assign v = p.selected_or_first_available_variant
  assign ch = block.settings.channels
  assign first = 'sms'
  if ch == 'email' or ch == 'email_sms'
    assign first = 'email'
  endif
  assign both = false
  if ch == 'sms_email' or ch == 'email_sms'
    assign both = true
  endif
  assign accent = app.metafields.colvy.accent.value | default: '#1f6feb'
  if block.settings.use_accent and block.settings.accent != blank
    assign accent = block.settings.accent
  endif
  if routes.root_url == '/'
    assign proxy = '/apps/colvy'
  else
    assign proxy = routes.root_url | append: '/apps/colvy'
  endif
-%}
{%- if p != blank -%}
<div
  class="colvy-bis"
  data-colvy-bis
  data-proxy="{{ proxy }}"
  data-product="{{ p.id }}"
  data-variant="{{ v.id }}"
  data-ch="{{ first }}"
  {% if request.design_mode %}data-preview="1"{% endif %}
  {% if customer %}data-me-name="{{ customer.first_name | escape }}" data-me-phone="{{ customer.phone | escape }}" data-me-email="{{ customer.email | escape }}"{% endif %}
  style="--cbis-accent: {{ accent }};"
  {% unless request.design_mode %}{% if v.available %}hidden{% endif %}{% endunless %}
  {{ block.shopify_attributes }}
>
  <script type="application/json" data-colvy-bis-variants>[{%- for x in p.variants -%}{"id":{{ x.id }},"a":{{ x.available }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]</script>
  <div class="colvy-bis__in">
    <div class="colvy-bis__ask">
      <div class="colvy-bis__head">
        <span class="colvy-bis__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
        </span>
        <div>
          <div class="colvy-bis__title">{{ block.settings.heading | escape }}</div>
          <div class="colvy-bis__sub">{{ block.settings.message | escape }}</div>
        </div>
      </div>
      <div class="colvy-bis__form" role="form">
        {%- if both -%}
          <div class="colvy-bis__seg" role="radiogroup" aria-label="How should we tell you?">
            <span class="colvy-bis__thumb" aria-hidden="true"></span>
            {%- if first == 'sms' -%}{%- assign order = 'sms,email' | split: ',' -%}{%- else -%}{%- assign order = 'email,sms' | split: ',' -%}{%- endif -%}
            {%- for c in order -%}
              <button type="button" role="radio" data-ch="{{ c }}" aria-checked="{% if c == first %}true{% else %}false{% endif %}">
                {%- if c == 'sms' -%}
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="2.5" width="12" height="19" rx="2.5"/><path d="M11 18h2"/></svg><span>Text me</span>
                {%- else -%}
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="4.5" width="19" height="15" rx="2"/><path d="m3 6 9 7 9-7"/></svg><span>Email me</span>
                {%- endif -%}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
        {%- if block.settings.ask_name -%}
          <label class="colvy-bis__field"><span class="colvy-bis__sr">First name</span><input type="text" name="name" autocomplete="given-name" placeholder="First name" maxlength="80"></label>
        {%- endif -%}
        <div class="colvy-bis__row">
          <label class="colvy-bis__field colvy-bis__f-sms"><span class="colvy-bis__sr">Mobile number</span><svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="2.5" width="12" height="19" rx="2.5"/><path d="M11 18h2"/></svg><input type="tel" name="phone" inputmode="tel" autocomplete="tel" placeholder="Mobile number" maxlength="30"></label>
          <label class="colvy-bis__field colvy-bis__f-email"><span class="colvy-bis__sr">Email</span><svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="4.5" width="19" height="15" rx="2"/><path d="m3 6 9 7 9-7"/></svg><input type="email" name="email" inputmode="email" autocomplete="email" placeholder="Email address" maxlength="120"></label>
          <button type="button" class="colvy-bis__btn"><span class="colvy-bis__lbl">{{ block.settings.button | escape }}</span><span class="colvy-bis__spin" aria-hidden="true"></span></button>
        </div>
        <input type="text" name="website" class="colvy-bis__hp" tabindex="-1" autocomplete="off" aria-hidden="true">
        <p class="colvy-bis__err" role="alert" aria-live="polite"></p>
        <p class="colvy-bis__fine">{{ block.settings.fine_print | escape }}</p>
      </div>
    </div>
    <div class="colvy-bis__done" hidden>
      <div class="colvy-bis__mark" aria-hidden="true"></div>
      <div>
        <div class="colvy-bis__title colvy-bis__done-t">You're on the list</div>
        <div class="colvy-bis__sub colvy-bis__done-s"></div>
        <button type="button" class="colvy-bis__again">Use a different number</button>
      </div>
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Back in stock (Colvy)",
  "target": "section",
  "enabled_on": { "templates": ["product"] },
  "stylesheet": "colvy-bis.css",
  "javascript": "colvy-bis.js",
  "settings": [
    { "type": "paragraph", "content": "Shows under a sold-out size or variant. Shoppers leave a mobile number or email and Colvy texts them once when it's back in stock. Manage waitlists in Colvy → Waitlists." },
    { "type": "product", "id": "product", "label": "Product", "autofill": true },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Sold out — for now" },
    { "type": "textarea", "id": "message", "label": "Message", "default": "Leave your number and we'll text you the moment it's back. One message, no spam." },
    { "type": "text", "id": "button", "label": "Button", "default": "Notify me" },
    {
      "type": "select", "id": "channels", "label": "How shoppers can be told", "default": "sms_email",
      "options": [
        { "value": "sms_email", "label": "Text or email (text first)" },
        { "value": "email_sms", "label": "Email or text (email first)" },
        { "value": "sms", "label": "Text only" },
        { "value": "email", "label": "Email only" }
      ]
    },
    { "type": "checkbox", "id": "ask_name", "label": "Ask for their first name", "default": false },
    { "type": "text", "id": "fine_print", "label": "Fine print", "default": "We'll only message you about this item. Reply STOP to opt out." },
    { "type": "checkbox", "id": "use_accent", "label": "Use my own button colour", "info": "Off: your Colvy brand colour.", "default": false },
    { "type": "color", "id": "accent", "label": "Button colour", "default": "#1f6feb" }
  ]
}
{% endschema %}
