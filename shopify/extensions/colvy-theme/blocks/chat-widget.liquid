{%- comment -%}
  Colvy — chat widget. Adds the Colvy chat bubble to every storefront page,
  the same widget as colvy.com/widget.js on any other site. The workspace is
  filled in by Colvy when the store is connected (an app metafield), so there
  is nothing to type; the setting below only overrides it. The store's own
  address always goes along too: if the metafield isn't there, widget.js asks
  Colvy which workspace this store is connected to, so the chat still shows.
{%- endcomment -%}
{%- assign slug = block.settings.slug | strip | default: app.metafields.colvy.slug.value -%}
{%- comment -%}
  A shopper signed in to their store account: their name, email and mobile
  fill in the chat's start form, so they don't type them again. Only a
  prefill: they can change it, and Colvy treats it like anything typed.
{%- endcomment -%}
{%- if customer -%}
  {%- assign cv_name = customer.name | strip -%}
  {%- assign cv_phone = customer.phone | default: customer.default_address.phone | strip -%}
{%- endif -%}
{%- # theme-check-disable RemoteAsset -%}
{%- comment -%} The chat widget is Colvy's own script, versioned with Colvy (not this extension), so it loads from colvy.com. {%- endcomment -%}
<script src="https://colvy.com/widget.js"{% if slug != blank %} data-slug="{{ slug | escape }}"{% endif %} data-shop="{{ shop.permanent_domain | escape }}"{% if customer %}{% if cv_name != blank %} data-visitor-name="{{ cv_name | escape }}"{% endif %}{% if customer.email != blank %} data-visitor-email="{{ customer.email | escape }}"{% endif %}{% if cv_phone != blank %} data-visitor-phone="{{ cv_phone | escape }}"{% endif %}{% endif %} async></script>
{%- # theme-check-enable RemoteAsset -%}

{% schema %}
{
  "name": "Colvy chat",
  "target": "body",
  "settings": [
    { "type": "paragraph", "content": "Shows your Colvy chat on every page. Change its colour, label and position in Colvy → Settings → Chat widget." },
    { "type": "text", "id": "slug", "label": "Workspace (optional)", "info": "Filled in automatically when this store is connected to Colvy. Only set it to show a different workspace's chat." }
  ]
}
{% endschema %}
